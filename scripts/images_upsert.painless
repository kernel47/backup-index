// Partial enrichments; null means unavailable, never erase a known value.
def incoming = params.document;
def allowed = ['master_server','technology','region','image_id','backup_id','client','policy','policy_type','schedule','schedule_type','backup_time','expiration_time','retention_level','copy_number','storage_location','kilobytes','updated_at','collected_at','data'];
for (def key : incoming.keySet()) {
    if (!allowed.contains(key)) { throw new IllegalArgumentException('Unknown image field'); }
}
if (incoming.master_server == null || incoming.image_id == null || incoming.updated_at == null) {
    throw new IllegalArgumentException('Missing image identity or observation');
}
def observed = Instant.parse(incoming.updated_at);
if (incoming.data != null && !(incoming.data instanceof Map)) { throw new IllegalArgumentException('data must be an object'); }
if (ctx.op == 'create') {
    ctx._source.putAll(incoming); ctx._source.created_at = incoming.updated_at; return;
}
if (ctx._source.master_server != incoming.master_server || ctx._source.image_id != incoming.image_id ||
    ctx._source.updated_at == null || !observed.isAfter(Instant.parse(ctx._source.updated_at))) {
    ctx.op = 'none'; return;
}
boolean correction = params.containsKey('allow_corrections') && params.allow_corrections == true;
def next = new HashMap(ctx._source);
for (def entry : incoming.entrySet()) {
    if (entry.getValue() != null && !['data'].contains(entry.getKey())) {
        def key = entry.getKey();
        if (!['updated_at','collected_at'].contains(key) && next[key] != null && next[key] != entry.getValue() && !correction) {
            ctx.op = 'none'; return;
        }
        next[key] = entry.getValue();
    }
}
if (incoming.data != null) {
    def merged = next.data == null ? new HashMap() : new HashMap(next.data);
    for (def entry : incoming.data.entrySet()) {
        if (entry.getValue() != null) {
            if (merged[entry.getKey()] != null && merged[entry.getKey()] != entry.getValue() && !correction) {
                ctx.op = 'none'; return;
            }
            merged[entry.getKey()] = entry.getValue();
        }
    }
    next.data = merged;
}
if (next.equals(ctx._source)) { ctx.op = 'none'; return; }
ctx._source.clear(); ctx._source.putAll(next);
