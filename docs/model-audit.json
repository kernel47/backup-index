  "decisions": [
    "Job.job_id (alias id) is exported as job_id by the existing collector; keyword.",
    "Job.type and Job.elapsed_seconds replace proposed job_type and elapsed_time.",
    "Job.status is int | str | None: keyword, not integer.",
    "Job.percent_complete is int | None: integer, not float.",
    "Job.policy_type and schedule_type are not declared/populated; omitted from active mapping.",
    "Image.retention_level is str | int | None: keyword, not integer.",
    "Image.storage_location is declared and populated: keyword.",
    "Image.num_files is absent: omitted until confirmed in source.",
    "Policy.retention and SLP.retention are Any: kept under data.",
    "SLP has active, status, target_storage; no declared state or slp_version.",
    "No parse_content function was found in the inspected current nbu source.",
    "Dates are datetime | str | None: validate UTC ISO-8601 before future ingestion; no parser changes.",
    "NbuModel.extra=allow: undeclared extras are not automatically promoted to indexed fields."
  ],
