        "type": "keyword"
      },
      "master_server": {
        "type": "keyword"
      },
      "image_id": {
        "type": "keyword"
      },
      "path": {
        "type": "keyword"
      },
      "backup_time": {
        "type": "date"
      },
      "created_at": {
        "type": "date"
      }
    }
  }
}
