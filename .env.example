# OpenSearch
OPENSEARCH_URL=https://opensearch.example.com:9200
OPENSEARCH_USERNAME=backup_index_admin
OPENSEARCH_PASSWORD=change-me
# TLS
OPENSEARCH_VERIFY_SSL=true
OPENSEARCH_CA_CERT=
# Client
OPENSEARCH_TIMEOUT=30
# Index configuration
INDEX_PREFIX=backup
MAPPINGS_DIR=mappings
# Logging
LOG_LEVEL=INFO

# Future ingestion script parameter (not an index mapping setting)
HISTORY_MAX_VERSIONS=10
